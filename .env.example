APP_ENV=development
SECRET_KEY=change-me-to-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=60
# SQLite by default; a postgres:// URL works after `uv sync --group postgres`
DATABASE_URL=sqlite+aiosqlite:///./echo.db
DEMO_MODE=true
ADMIN_EMAILS=
LOG_LEVEL=INFO
# mock | chain
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_S=8
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_CALLS_PER_SESSION=30
# Optional voice/video (8x8 JaaS): AppID, API key id and the path to its RS256 private key
ENABLE_VOICE_VIDEO=false
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH=
